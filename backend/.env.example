# Any OpenAI-compatible endpoint. Groq by default; for a local model point it at
# a llama.cpp server (http://localhost:8080/v1) or Ollama (http://localhost:11434/v1).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
PARSE_MODEL=openai/gpt-oss-20b
NARRATE_MODEL=openai/gpt-oss-120b
GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# SQLite by default; PostgreSQL in docker-compose.
# DATABASE_URL=postgresql+psycopg://chef:chef@localhost:5432/nesychef
ADMIN_TOKEN=change-me-admin

# Production hardening. With ENVIRONMENT=production the knowledge console stays
# disabled until ADMIN_TOKEN is changed from its default.
ENVIRONMENT=development
# Natural-language requests allowed per client per minute.
RATE_LIMIT_PER_MINUTE=10
# LLM-backed requests per day; beyond it the assistant answers deterministically.
DAILY_LLM_BUDGET=300
